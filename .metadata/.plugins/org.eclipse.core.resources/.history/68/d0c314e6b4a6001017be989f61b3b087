package com.jao.login_auth_ms;

import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.context.ActiveProfiles;
import com.jao.login_auth_ms.domain.model.User;
import com.jao.login_auth_ms.domain.port.in.LoginAuthUseCase;
import com.jao.login_auth_ms.domain.port.out.LoginAttemptCachePort;
import com.jao.login_auth_ms.domain.port.out.UserPersistencePort;
import com.jao.login_auth_ms.domain.service.LoginAuthService;
import com.jao.login_auth_ms.infrastructure.adapter.out.jwt.JwtService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.security.authentication.AuthenticationManager;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.Authentication;

import java.util.Optional;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

// Permite usar las anotaciones @Mock y @InjectMocks
@ExtendWith(MockitoExtension.class)

@SpringBootTest
@ActiveProfiles("test")
class LoginAuthMsApplicationTests {

	 // 1. EL SUJETO DE PRUEBA: La clase que vamos a probar.
    // @InjectMocks inyecta los mocks marcados con @Mock en el constructor o campos.
    @InjectMocks
    private LoginAuthService loginAuthService;

    // 2. DEPENDENCIAS (Mocks): Representan las dependencias (Puertos, Servicios externos) que
    // el LoginAuthService necesita en su constructor.
    @Mock
    private UserPersistencePort userPersistencePort;
    @Mock
    private LoginAttemptCachePort loginAttemptCachePort;
    @Mock
    private AuthenticationManager authenticationManager;
    @Mock
    private JwtService jwtService;
    
    // Mocks adicionales para simular objetos de Spring Security
    @Mock
    private Authentication authentication;

    private User validUser;

    @BeforeEach
    void setUp() {
        // Inicializa un usuario de prueba válido.
        validUser = User.builder()
                .email("test@example.com")
                .password("encoded_password")
                .role("USER")
                .build();
    }
    
    // -------------------------------------------------------------
    // Caso de Prueba 1: Login Exitoso
    // -------------------------------------------------------------

    @Test
    void successfulLogin_shouldReturnTokenAndResetAttempts() {
        // ARRANGE (Configuración de Mocks y Datos)

        String testEmail = "test@example.com";
        String testPassword = "password123";
        String expectedToken = "mocked.jwt.token";

        // 1. Simular la obtención del usuario desde la base de datos (puerto de persistencia).
        when(userPersistencePort.findByEmail(testEmail)).thenReturn(Optional.of(validUser));
        
        // 2. Simular la autenticación de Spring Security como exitosa.
        when(authenticationManager.authenticate(any(UsernamePasswordAuthenticationToken.class)))
                .thenReturn(authentication);
        
        // 3. Simular la generación del token JWT.
        when(jwtService.generateToken(validUser)).thenReturn(expectedToken);
        
        // 4. Simular que el usuario NO está bloqueado.
        when(loginAttemptCachePort.isBlocked(testEmail)).thenReturn(false);


        // ACT (Ejecución del método a probar)
        // Creamos el DTO de solicitud
        LoginAuthUseCase.LoginCommand command = new LoginAuthUseCase.LoginCommand(testEmail, testPassword);
        
        // Llamamos al método
        String actualToken = loginAuthService.login(command);

        // ASSERT (Verificación de Resultados y Comportamiento)

        // 1. Verificar que el resultado no es nulo y es el token esperado.
        assertNotNull(actualToken, "El token no debe ser nulo.");
        assertEquals(expectedToken, actualToken, "El token devuelto debe coincidir con el token mockeado.");

        // 2. Verificar que se intentó autenticar con Spring Security.
        verify(authenticationManager).authenticate(
                new UsernamePasswordAuthenticationToken(testEmail, testPassword));
        
        // 3. Verificar que se generó el token JWT.
        verify(jwtService).generateToken(validUser);
        
        // 4. Verificar que se llamó a resetAttempts (si el login fue exitoso).
        verify(loginAttemptCachePort).resetAttempts(testEmail);
        
        // 5. Verificar que NO se llamó a incrementLoginAttempts (solo se llama en caso de fallo).
        verify(loginAttemptCachePort, never()).incrementLoginAttempts(anyString());
    }

    // Puedes añadir más tests aquí:
    // @Test
    // void failedLogin_shouldIncrementAttempts() { ... }
    
    // @Test
    // void login_shouldFailIfUserIsBlocked() { ... }
}
