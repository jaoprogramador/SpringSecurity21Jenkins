package com.jao.login_auth_ms;

import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration;
import org.springframework.boot.autoconfigure.orm.jpa.HibernateJpaAutoConfiguration;
import org.springframework.boot.autoconfigure.security.servlet.SecurityAutoConfiguration;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.jao.login_auth_ms.application.dto.LoginRequest;
import com.jao.login_auth_ms.domain.port.in.LoginUseCase;
import com.jao.login_auth_ms.infrastructure.adapter.in.LoginController;


// @WebMvcTest enfoca el test solo en el Controller y la capa de Web.
// Es más rápido que @SpringBootTest y solo carga los beans necesarios.
@WebMvcTest(
	    controllers = LoginController.class, 
	    excludeAutoConfiguration = {
	        SecurityAutoConfiguration.class, 
	        DataSourceAutoConfiguration.class, // Excluir configuración de DataSource
	        HibernateJpaAutoConfiguration.class  // Excluir configuración de JPA/Hibernate
	    } 
	)
public class LoginControllerIntegrationTest {

    @Autowired
    private MockMvc mockMvc; // Para simular las peticiones HTTP

    @Autowired
    private ObjectMapper objectMapper; // Para convertir DTOs a JSON

    // MOCKEAMOS la dependencia de la capa de dominio
    // Esto asegura que el test solo prueba el Controller y no la lógica de servicio.
    @MockBean
    private LoginUseCase loginUseCase;

    private final String LOGIN_URL = "/api/v1/auth/login";

    // -------------------------------------------------------------
    // CASO DE PRUEBA 1: Login Exitoso (200 OK y Token devuelto)
    // -------------------------------------------------------------
    @Test
    void login_shouldReturnTokenAnd200_whenCredentialsAreValid() throws Exception {
        // ARRANGE (Configuración)
        String expectedToken = "mocked.jwt.token.12345";
        LoginRequest request = new LoginRequest("test@example.com", "password123");

        // Simular el comportamiento del Use Case: cuando se llama, debe devolver el token.
        when(loginUseCase.authenticate(anyString(), anyString()))
                .thenReturn(expectedToken);

        // ACT & ASSERT (Ejecución y Verificación)
        mockMvc.perform(post(LOGIN_URL)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(request))) // Convertir DTO a JSON
                
                // 1. Verificar el código de estado HTTP
                .andExpect(status().isOk()) // Esperamos un 200 OK
                
                // 2. Verificar el contenido de la respuesta (el token)
                .andExpect(content().string(expectedToken));
    }

    // -------------------------------------------------------------
    // CASO DE PRUEBA 2: Credenciales Inválidas (Simular error de Dominio)
    // -------------------------------------------------------------
    @Test
    void login_shouldReturn401Or400_whenCredentialsAreInvalid() throws Exception {
        // ARRANGE (Configuración)
        LoginRequest request = new LoginRequest("wrong@example.com", "wrongPassword");

        // Simular el comportamiento del Use Case: si falla la autenticación, lanza una RuntimeException
        when(loginUseCase.authenticate(anyString(), anyString()))
                .thenThrow(new RuntimeException("Credenciales inválidas"));

        // ACT & ASSERT (Ejecución y Verificación)
        // Nota: Si no tienes un @ControllerAdvice global para capturar RuntimeException,
        // Spring puede devolver 500. Asumimos un 400/401 es capturado por un ControllerAdvice.
        // Dado que el servicio lanza una RuntimeException con el mensaje 'Credenciales inválidas',
        // el test verifica que el status NO es 200 (podría ser 400, 401 o 500).
        mockMvc.perform(post(LOGIN_URL)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(request)))
                .andExpect(status().is4xxClientError()); // Esperamos un 4xx (Bad Request/Unauthorized)
    }

    // -------------------------------------------------------------
    // CASO DE PRUEBA 3: Validación del DTO (Request Body Inválido)
    // -------------------------------------------------------------
    // Nota: Esto requiere que LoginRequest tenga anotaciones como @NotBlank o @Email.
    @Test
    void login_shouldReturn400_whenEmailIsMissing() throws Exception {
        // ARRANGE (Configuración)
        // Asumimos que la clase LoginRequest tiene un @NotBlank en el campo email.
        LoginRequest invalidRequest = new LoginRequest(null, "password123");

        // ACT & ASSERT (Ejecución y Verificación)
        // La anotación @Valid en el Controller debería causar un 400 BAD REQUEST
        mockMvc.perform(post(LOGIN_URL)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(invalidRequest)))
                .andExpect(status().isBadRequest()); // Esperamos 400 BAD REQUEST
    }
}
