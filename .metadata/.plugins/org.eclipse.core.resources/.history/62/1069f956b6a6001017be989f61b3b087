package com.jao.login_auth_ms;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

import java.util.Optional;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.security.authentication.AuthenticationManager;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.Authentication;
import org.springframework.test.context.ActiveProfiles;

import com.jao.login_auth_ms.domain.model.User;
import com.jao.login_auth_ms.domain.port.in.LoginAuthUseCase;
import com.jao.login_auth_ms.domain.port.out.LoginAttemptCachePort;
import com.jao.login_auth_ms.domain.port.out.UserPersistencePort;
import com.jao.login_auth_ms.domain.service.LoginAuthService;
import com.jao.login_auth_ms.infrastructure.config.JwtService;

// Permite usar las anotaciones @Mock y @InjectMocks
@ExtendWith(MockitoExtension.class)

@SpringBootTest
@ActiveProfiles("test")
class LoginAuthMsApplicationTests {

	// SUJETO DE PRUEBA
    @InjectMocks
    private LoginAuthService loginAuthService;

    // DEPENDENCIAS MOCKEADAS
    @Mock
    private UserPersistencePort userPersistencePort;
    @Mock
    private LoginAttemptCachePort loginAttemptCachePort;
    @Mock
    private AuthenticationManager authenticationManager;
    @Mock
    private JwtService jwtService;
    
    // Mocks auxiliares para Spring Security
    @Mock
    private Authentication authentication;

    private User validUser;
    private final String TEST_EMAIL = "test@example.com";
    private final String TEST_PASSWORD = "password123";

    @BeforeEach
    void setUp() {
        // Inicializa un usuario de dominio válido con el constructor @AllArgsConstructor
        validUser = new User(
                1L, // id
                "testUser", // username
                TEST_EMAIL, // email
                "hashedPassword", // passwordHash (no se usa directamente en el servicio)
                0, // failedLoginAttempts
                true, // isAccountNonLocked
                null, // lockTime
                "USER" // role
        );
    }
    
    // -------------------------------------------------------------
    // Caso de Prueba 1: Login Exitoso (TDD Step 1: Green)
    // -------------------------------------------------------------

    @Test
    void successfulLogin_shouldReturnTokenAndResetAttempts() {
        // ARRANGE (Configuración de Mocks y Datos)

        String expectedToken = "mocked.jwt.token";

        // 1. Simular que el usuario NO está bloqueado por el caché.
        when(loginAttemptCachePort.isBlocked(TEST_EMAIL)).thenReturn(false);
        
        // 2. Simular la autenticación de Spring Security como exitosa.
        // El AuthenticationManager no lanza excepción al autenticar.
        when(authenticationManager.authenticate(any(UsernamePasswordAuthenticationToken.class)))
                .thenReturn(authentication);
        
        // 3. Simular la obtención del usuario desde la base de datos (puerto de persistencia).
        // Se necesita para generar el token JWT.
        when(userPersistencePort.findByEmail(TEST_EMAIL)).thenReturn(Optional.of(validUser));
        
        // 4. Simular la generación del token JWT.
        when(jwtService.generateToken(validUser)).thenReturn(expectedToken);
        

        // ACT (Ejecución del método a probar)
        LoginAuthUseCase.LoginCommand command = new LoginAuthUseCase.LoginCommand(TEST_EMAIL, TEST_PASSWORD);
        String actualToken = loginAuthService.login(command);

        // ASSERT (Verificación de Resultados y Comportamiento)

        // 1. Verificar que el resultado es el token esperado.
        assertNotNull(actualToken, "El token no debe ser nulo.");
        assertEquals(expectedToken, actualToken, "El token devuelto debe coincidir con el token mockeado.");

        // 2. Verificar que se intentó autenticar con Spring Security.
        verify(authenticationManager).authenticate(
                new UsernamePasswordAuthenticationToken(TEST_EMAIL, TEST_PASSWORD));
        
        // 3. Verificar que se reseteó el contador de intentos de login.
        verify(loginAttemptCachePort).resetAttempts(TEST_EMAIL);
        
        // 4. Verificar que se generó el token JWT.
        verify(jwtService).generateToken(validUser);
        
        // 5. Verificar que NO se llamó a incrementLoginAttempts (solo se llama en caso de fallo).
        verify(loginAttemptCachePort, never()).incrementLoginAttempts(anyString());
    }
}
